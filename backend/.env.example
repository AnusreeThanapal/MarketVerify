PROJECT_NAME=MarketVerify
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# API Server
HOST=0.0.0.0
PORT=8005

# PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/marketverify
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/marketverify

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_CHANNEL=marketverify:agent_trace

# Qdrant Vector DB (Separate Collections)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_TRUST=trust_tier_store
QDRANT_COLLECTION_FILING=filing_store
QDRANT_COLLECTION_SENTIMENT=sentiment_corpus

# Embeddings / LLM Provider
EMBEDDING_DIMENSION=384
USE_MOCK_EMBEDDINGS=True
OPENAI_API_KEY=your-openai-api-key-here

# JWT Authentication
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
